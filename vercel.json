{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/ofm/:path*",
      "destination": "https://tiles.openfreemap.org/:path*"
    },
    {
      "source": "/photo/wikipedia/commons/:a([0-9a-f])/:b([0-9a-f][0-9a-f])/:file([^/]+\\.(?:jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP))",
      "destination": "https://upload.wikimedia.org/wikipedia/commons/:a/:b/:file"
    },
    {
      "source": "/thumb/wikipedia/commons/thumb/:a([0-9a-f])/:b([0-9a-f][0-9a-f])/:orig([^/]+\\.(?:jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP))/:size([1-9][0-9][0-9]px-[^/]+\\.(?:jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP))",
      "destination": "https://thumb.wikimedia.org/wikipedia/commons/thumb/:a/:b/:orig/:size"
    }
  ],
  "headers": [
    {
      "source": "/(fonts|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/photo/(.*)",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/thumb/(.*)",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/ofm/(.*)",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
